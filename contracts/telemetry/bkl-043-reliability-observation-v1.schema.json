{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.local/contracts/telemetry/bkl-043-reliability-observation-v1.schema.json",
  "title": "BKL-043 Reliability Observation Envelope (Proposal)",
  "description": "Offline contract proposal for source observations and independent witness receipts. Evidence only; not a runtime authorization, health decision, incident, command, or safety signal.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "record_type",
    "component_id",
    "source_id",
    "source_observed_at_utc",
    "received_at_utc",
    "clock_quality",
    "source_quality",
    "coverage_state",
    "source_sequence",
    "host_boot_id",
    "process_run_id",
    "reason_code",
    "payload_digest",
    "command_authority",
    "execution_authority",
    "safety_authority"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "record_type": { "enum": ["SOURCE_OBSERVATION", "WITNESS_RECEIPT"] },
    "component_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "source_id": { "type": "string", "minLength": 1, "maxLength": 120 },
    "source_observed_at_utc": { "type": ["string", "null"], "format": "date-time" },
    "received_at_utc": { "type": ["string", "null"], "format": "date-time" },
    "clock_quality": { "enum": ["SYNCHRONIZED", "UNSYNCHRONIZED", "UNKNOWN"] },
    "source_quality": { "enum": ["CURRENT", "STALE", "UNKNOWN", "UNAVAILABLE", "CONFLICTING"] },
    "coverage_state": { "enum": ["COVERED", "UNKNOWN_GAP", "EXCLUDED"] },
    "source_sequence": { "type": ["integer", "null"], "minimum": 0 },
    "host_boot_id": { "type": ["string", "null"], "maxLength": 160 },
    "process_run_id": { "type": ["string", "null"], "maxLength": 160 },
    "reason_code": { "type": ["string", "null"], "maxLength": 120 },
    "payload_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "command_authority": { "const": "NONE" },
    "execution_authority": { "const": "NONE" },
    "safety_authority": { "const": "NONE" }
  }
}
