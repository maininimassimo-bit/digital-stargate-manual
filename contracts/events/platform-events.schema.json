{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.local/schemas/platform-events/1.0.0",
  "title": "Digital StarGate Platform Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventName", "occurredAt", "producer", "version", "correlationId", "payload"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventName": {
      "type": "string",
      "enum": [
        "SessionCreated", "SessionStarted", "SessionCompleted", "SessionAborted",
        "TargetAcquired", "ExposureStarted", "ExposureCompleted", "CalibrationCompleted",
        "WeatherUnsafeDetected", "RoofOpened", "RoofClosed", "MountParked",
        "TelemetryCollected", "AlertRaised", "ConfigurationChanged"
      ]
    },
    "occurredAt": { "type": "string", "format": "date-time" },
    "producer": { "type": "string", "minLength": 1 },
    "version": { "const": "1.0.0" },
    "correlationId": { "type": "string", "format": "uuid" },
    "causationId": { "type": ["string", "null"], "format": "uuid" },
    "traceId": { "type": ["string", "null"] },
    "payload": { "type": "object" }
  },
  "oneOf": [
    { "$ref": "#/$defs/sessionCreated" },
    { "$ref": "#/$defs/sessionStarted" },
    { "$ref": "#/$defs/sessionCompleted" },
    { "$ref": "#/$defs/sessionAborted" },
    { "$ref": "#/$defs/targetAcquired" },
    { "$ref": "#/$defs/exposureStarted" },
    { "$ref": "#/$defs/exposureCompleted" },
    { "$ref": "#/$defs/calibrationCompleted" },
    { "$ref": "#/$defs/weatherUnsafeDetected" },
    { "$ref": "#/$defs/roofOpened" },
    { "$ref": "#/$defs/roofClosed" },
    { "$ref": "#/$defs/mountParked" },
    { "$ref": "#/$defs/telemetryCollected" },
    { "$ref": "#/$defs/alertRaised" },
    { "$ref": "#/$defs/configurationChanged" }
  ],
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "sessionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId"],
      "properties": { "sessionId": { "$ref": "#/$defs/uuid" } }
    },
    "sessionCreatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "targetId", "observatoryId"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuid" },
        "targetId": { "$ref": "#/$defs/uuid" },
        "observatoryId": { "$ref": "#/$defs/uuid" }
      }
    },
    "sessionAbortedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "reason"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuid" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "targetAcquiredPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "targetId"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuid" },
        "targetId": { "$ref": "#/$defs/uuid" }
      }
    },
    "exposureStartedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "exposureTimeSeconds"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuid" },
        "exposureTimeSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "exposureCompletedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "imageId"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuid" },
        "imageId": { "$ref": "#/$defs/uuid" }
      }
    },
    "calibrationCompletedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessionId", "imageIds"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/uuid" },
        "imageIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/uuid" } }
      }
    },
    "weatherUnsafeDetectedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observatoryId", "reason"],
      "properties": {
        "observatoryId": { "$ref": "#/$defs/uuid" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "equipmentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equipmentId"],
      "properties": { "equipmentId": { "$ref": "#/$defs/uuid" } }
    },
    "telemetryCollectedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "metric", "value", "unit"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "metric": { "type": "string", "minLength": 1 },
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "alertRaisedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alertId", "severity", "code", "message"],
      "properties": {
        "alertId": { "$ref": "#/$defs/uuid" },
        "severity": { "type": "string", "enum": ["debug", "info", "warning", "error", "critical"] },
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "configurationChangedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "key", "source"],
      "properties": {
        "section": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "sessionCreated": { "properties": { "eventName": { "const": "SessionCreated" }, "payload": { "$ref": "#/$defs/sessionCreatedPayload" } } },
    "sessionStarted": { "properties": { "eventName": { "const": "SessionStarted" }, "payload": { "$ref": "#/$defs/sessionPayload" } } },
    "sessionCompleted": { "properties": { "eventName": { "const": "SessionCompleted" }, "payload": { "$ref": "#/$defs/sessionPayload" } } },
    "sessionAborted": { "properties": { "eventName": { "const": "SessionAborted" }, "payload": { "$ref": "#/$defs/sessionAbortedPayload" } } },
    "targetAcquired": { "properties": { "eventName": { "const": "TargetAcquired" }, "payload": { "$ref": "#/$defs/targetAcquiredPayload" } } },
    "exposureStarted": { "properties": { "eventName": { "const": "ExposureStarted" }, "payload": { "$ref": "#/$defs/exposureStartedPayload" } } },
    "exposureCompleted": { "properties": { "eventName": { "const": "ExposureCompleted" }, "payload": { "$ref": "#/$defs/exposureCompletedPayload" } } },
    "calibrationCompleted": { "properties": { "eventName": { "const": "CalibrationCompleted" }, "payload": { "$ref": "#/$defs/calibrationCompletedPayload" } } },
    "weatherUnsafeDetected": { "properties": { "eventName": { "const": "WeatherUnsafeDetected" }, "payload": { "$ref": "#/$defs/weatherUnsafeDetectedPayload" } } },
    "roofOpened": { "properties": { "eventName": { "const": "RoofOpened" }, "payload": { "$ref": "#/$defs/equipmentPayload" } } },
    "roofClosed": { "properties": { "eventName": { "const": "RoofClosed" }, "payload": { "$ref": "#/$defs/equipmentPayload" } } },
    "mountParked": { "properties": { "eventName": { "const": "MountParked" }, "payload": { "$ref": "#/$defs/equipmentPayload" } } },
    "telemetryCollected": { "properties": { "eventName": { "const": "TelemetryCollected" }, "payload": { "$ref": "#/$defs/telemetryCollectedPayload" } } },
    "alertRaised": { "properties": { "eventName": { "const": "AlertRaised" }, "payload": { "$ref": "#/$defs/alertRaisedPayload" } } },
    "configurationChanged": { "properties": { "eventName": { "const": "ConfigurationChanged" }, "payload": { "$ref": "#/$defs/configurationChangedPayload" } } }
  }
}
