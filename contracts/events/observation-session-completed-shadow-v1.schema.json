{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.local/schemas/observation/session-completed/1.0.0-shadow",
  "title": "Digital StarGate SessionCompleted Shadow Integration Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "event_state",
    "message_id",
    "correlation_id",
    "producer",
    "subject",
    "schema_uri",
    "classification",
    "freshness",
    "transport",
    "runtime_published",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contract_id": {
      "const": "DSG.Observation.Event.SessionCompleted"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "event_state": {
      "const": "SHADOW_VALIDATED"
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "published_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "const": "N.I.N.A. session adapter (shadow candidate)"
    },
    "subject": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}_\\d{4}-\\d{2}-\\d{2}$"
    },
    "schema_uri": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "const": "internal"
    },
    "freshness": {
      "enum": [
        "current",
        "stale",
        "unknown"
      ]
    },
    "transport": {
      "const": "repository-shadow-artifact"
    },
    "runtime_published": {
      "const": false
    },
    "payload": {
      "$ref": "#/$defs/sessionPayload"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}_\\d{4}-\\d{2}-\\d{2}$"
    },
    "sessionPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "observatory",
        "session_window",
        "report_status",
        "diagnostic_severity",
        "equipment",
        "manifest",
        "projections",
        "no_hardware_commands",
        "command_authority",
        "safety_authority"
      ],
      "properties": {
        "session_id": {
          "$ref": "#/$defs/sessionId"
        },
        "observatory": {
          "type": "string",
          "minLength": 1
        },
        "session_window": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_local",
            "end_local",
            "timezone_id"
          ],
          "properties": {
            "start_local": {
              "type": "string",
              "format": "date-time"
            },
            "end_local": {
              "type": "string",
              "format": "date-time"
            },
            "timezone_id": {
              "const": "Europe/Rome"
            }
          }
        },
        "report_status": {
          "const": "COMPLETE"
        },
        "diagnostic_level": {
          "type": "integer",
          "minimum": 0
        },
        "diagnostic_severity": {
          "enum": [
            "GREEN",
            "YELLOW",
            "ORANGE",
            "RED",
            "UNKNOWN"
          ]
        },
        "diagnostic_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "equipment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configuration_id",
            "telescope",
            "camera",
            "target",
            "binning"
          ],
          "properties": {
            "configuration_id": {
              "type": "string",
              "minLength": 1
            },
            "telescope": {
              "type": "string",
              "minLength": 1
            },
            "camera": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "type": "string",
              "minLength": 1
            },
            "binning": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "git_blob_sha",
            "evidence_file_count",
            "evidence_files"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "git_blob_sha": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "evidence_file_count": {
              "type": "integer",
              "minimum": 1
            },
            "evidence_files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "size_bytes",
                  "sha256",
                  "modified_local"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "$ref": "#/$defs/sha256"
                  },
                  "modified_local": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              }
            }
          }
        },
        "projections": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "no_hardware_commands": {
          "const": true
        },
        "command_authority": {
          "const": "NONE"
        },
        "safety_authority": {
          "enum": [
            "NONE",
            "LOCAL_SAFETY_AUTHORITY"
          ]
        }
      }
    }
  }
}
