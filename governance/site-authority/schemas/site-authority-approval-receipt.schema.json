{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.invalid/schemas/site-authority-approval-receipt.schema.json",
  "title": "Digital StarGate Site Authority Approval Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "receiptId", "decision", "subject", "approvingAuthority", "approval", "repositoryEvidence", "scopeBoundaries", "integrity"],
  "properties": {
    "schemaVersion": { "const": "1.0.0-draft" },
    "recordType": { "const": "DSG_SITE_AUTHORITY_APPROVAL_RECEIPT" },
    "receiptId": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["APPROVED", "REJECTED"] },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["siteRecordId", "revision", "observatoryId", "payloadDigest", "validFromUtc", "validityEndMode", "validToUtc", "intervalSemantics"],
      "properties": {
        "siteRecordId": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "observatoryId": { "type": "string", "minLength": 1 },
        "payloadDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "validFromUtc": { "type": "string", "format": "date-time" },
        "validityEndMode": { "enum": ["EXCLUSIVE", "UNBOUNDED"] },
        "validToUtc": { "type": ["string", "null"], "format": "date-time" },
        "intervalSemantics": { "const": "HALF_OPEN" }
      }
    },
    "approvingAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorityRef", "authorityKind", "custodianIsApprover"],
      "properties": {
        "authorityRef": { "const": "github:user:maininimassimo-bit" },
        "authorityKind": { "const": "HUMAN_REPOSITORY_OWNER" },
        "custodianIsApprover": { "const": false }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvalTimestampUtc", "sourceChannel", "sourceStatement", "validityAcknowledged"],
      "properties": {
        "approvalTimestampUtc": { "type": "string", "format": "date-time" },
        "sourceChannel": { "const": "OWNER_CONTROLLED_INTERACTION_CHANNEL" },
        "sourceStatement": { "type": "string", "minLength": 1 },
        "validityAcknowledged": { "type": "boolean" }
      }
    },
    "repositoryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "branch", "candidatePath", "approvedPath", "receiptPath", "authorizationBaselineCommit"],
      "properties": {
        "repository": { "const": "maininimassimo-bit/digital-stargate-manual" },
        "branch": { "const": "feat/bkl-031-f3-a1-m4-site-authority-approval" },
        "candidatePath": { "const": "governance/site-authority/site-records/DSG-SITE-RECORD-MANCIANO-001.draft.json" },
        "approvedPath": { "const": "governance/site-authority/site-records/DSG-SITE-RECORD-MANCIANO-001.approved.json" },
        "receiptPath": { "const": "governance/site-authority/approval-evidence/DSG-SITE-RECORD-MANCIANO-001.approval.json" },
        "authorizationBaselineCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "scopeBoundaries": { "type": "array", "minItems": 7, "items": { "type": "string" }, "uniqueItems": true },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalizationMethod", "payloadDigestVerified", "payloadMutatedDuringApproval", "approvalSourceMatchesOwner"],
      "properties": {
        "canonicalizationMethod": { "const": "DSG-F3A1-CANONICAL-JSON-SHA256-1" },
        "payloadDigestVerified": { "const": true },
        "payloadMutatedDuringApproval": { "const": false },
        "approvalSourceMatchesOwner": { "const": true }
      }
    }
  }
}
