{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.invalid/schemas/site-source-decision.schema.json",
  "title": "Digital StarGate Site Source Decision Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordType", "decisionId", "decision", "decisionRecordedAtUtc", "decidingAuthority", "candidateRef", "decisions", "sourceAuthorization", "lifecycleBoundary"],
  "properties": {
    "schemaVersion": { "const": "1.0.0-draft" },
    "recordType": { "const": "DSG_SITE_SOURCE_DECISION_EVIDENCE" },
    "decisionId": { "type": "string", "minLength": 1 },
    "decision": { "const": "AUTHORIZED_FOR_DRAFT_MATERIALIZATION" },
    "decisionRecordedAtUtc": { "type": "string", "format": "date-time" },
    "decidingAuthority": { "const": "github:user:maininimassimo-bit" },
    "candidateRef": { "type": "string", "minLength": 1 },
    "decisions": { "type": "object" },
    "sourceAuthorization": { "type": "object" },
    "lifecycleBoundary": { "const": "NOT_AN_EXACT_DIGEST_APPROVAL" }
  }
}
