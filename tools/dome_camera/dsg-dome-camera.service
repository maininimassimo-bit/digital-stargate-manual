[Unit]
Description=Digital StarGate public dome camera read-only media relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
ExecStart=/usr/bin/python3 /usr/local/lib/digital-stargate/dome_camera_relay.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_UNIX
ProtectProc=invisible
UMask=0077
MemoryMax=256M
LimitAS=512M
TasksMax=40
CPUQuota=100%
Nice=10
StandardOutput=null
StandardError=null
TimeoutStopSec=8

[Install]
WantedBy=multi-user.target
