SELECT TOP 2000 o.observationID,o.target_name,o.instrument_name,o.proposal_id,p.productID,p.energy_bandpassName,p.time_exposure,p.calibrationLevel FROM caom2.Observation AS o JOIN caom2.Plane AS p ON o.obsID=p.obsID WHERE o.collection='HST' AND o.instrument_name LIKE 'ACS%' AND p.energy_bandpassName='F606W' AND INTERSECTS(p.position_bounds,CIRCLE('ICRS',76.37765243846,52.83116392105,0.01))=1