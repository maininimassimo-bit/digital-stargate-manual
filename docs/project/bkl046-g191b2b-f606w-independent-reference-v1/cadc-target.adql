SELECT TOP 2000 o.observationID,o.target_name,o.instrument_name,o.proposal_id,p.productID,p.energy_bandpassName,p.time_exposure,p.calibrationLevel FROM caom2.Observation AS o JOIN caom2.Plane AS p ON o.obsID=p.obsID WHERE o.collection='HST' AND o.instrument_name LIKE 'ACS%' AND p.energy_bandpassName='F606W' AND o.target_name IN ('G191B2B','G191-B2B','G191 B2B','WD0501+527','G191-B2B-CENTER')