/* Candidate definitions only. The original reviewed parent must supply
 * authorized scope, held input locks and a pinned host adapter.
 */
function DSGImageAnalysisControls(plan, host) {
   function need(ok, code) { if (!ok) throw Error('DSG_IA_'+code); }
   function exact(obj, fields) {
      return obj && typeof obj==='object' && !Array.isArray(obj) &&
         Object.keys(obj).sort().join(',')===fields.slice().sort().join(',');
   }
   const required=['compact-shuffled','compact-zones','tailed-shuffled','compact-wide-psf'];
   const metrics={fwhmPx:'FWHMpx',eccentricity:'Eccentricity',noise:'Noise',stars:'Stars',
      psfSignalWeight:'PSFSignalWeight',psfSnr:'PSFSNR',snr:'SNR',median:'Median',
      measurementSigma:'Sigma',mStar:'MStar'};
   const names=Object.keys(metrics);
   function canonical(p) {
      need(typeof p==='string' && /^[A-Za-z]:\/[\x20-\x7e]+$/.test(p) &&
         !/[\\":*?<>|]/.test(p.slice(2)) &&
         p.slice(3).split('/').every(s=>s && s!=='.' && s!=='..' && !/[. ]$/.test(s)),'INPUT_PATH');
      return p;
   }
   function pathKey(value) { return canonical(value.replace(/\\/g,'/')).toLowerCase(); }
   need(exact(plan,['operationRef','version','inputRoot','inputs']) &&
        typeof plan.operationRef==='string' && /^[a-f0-9]{32}$/.test(plan.operationRef) &&
        plan.version==='1.9.6 build 1719' && host.currentVersion()===plan.version &&
        Array.isArray(plan.inputs) && plan.inputs.length===required.length,'PLAN');
   const root=canonical(plan.inputRoot);
   for (let i=0;i<required.length;i++) {
      const input=plan.inputs[i];
      need(exact(input,['id','path','sha256','byteLength']) &&
         input.id===required[i] && input.path===root+'/'+input.id+'.fits' &&
         typeof input.sha256==='string' && /^[a-f0-9]{64}$/.test(input.sha256) &&
         input.byteLength===77760,'INPUT_PIN');
      canonical(input.path);
   }
   function inputsIntact() {
      host.guard();
      for (const input of plan.inputs) {
         const pin=host.fingerprint(input.path);
         need(exact(pin,['sha256','byteLength']) && pin.sha256===input.sha256 &&
              pin.byteLength===input.byteLength,'INPUT_CHANGED');
      }
      host.guard();
   }
   const process=host.ImageAnalysis;
   need(typeof process==='function' && Number.isInteger(process.Task_Measure) &&
        Number.isInteger(process.OnError_Continue),'IMAGE_ANALYSIS_API');
   const columns={};
   for (const key of names) columns[key]=process['measurements_measurement'+metrics[key]];
   const pathColumn=process.measurements_measurementPath;
   const indices=[pathColumn].concat(Object.values(columns));
   need(indices.every(n=>Number.isInteger(n) && n>=0 && n<4096) &&
        new Set(indices).size===indices.length,'MISSING_OR_AMBIGUOUS_COLUMN');
   const greatestColumn=Math.max.apply(null,indices);
   const byPath=new Map(plan.inputs.map(input=>[pathKey(input.path),input.id]));
   function measure(order) {
      inputsIntact();
      const instance=new process;
      instance.task=process.Task_Measure;
      instance.onError=process.OnError_Continue;
      instance.fileCache=false;
      instance.extendedMeasurements=false;
      // Match the four-column table rows generated by the installed WBPP helper.
      instance.frames=order.map(row=>[true,row.path,'','']);
      need(instance.fileCache===false && instance.extendedMeasurements===false &&
         instance.task===process.Task_Measure && instance.onError===process.OnError_Continue,'SETTINGS');
      host.guard();
      need(instance.executeGlobal()===true,'MEASUREMENT_FAILED');
      inputsIntact();
      const table=instance.measurements;
      need(Array.isArray(table) && table.length===order.length,'ROW_COUNT');
      const mapped=new Map;
      for (const row of table) {
         need(Array.isArray(row) && row.length>greatestColumn && typeof row[pathColumn]==='string','ROW_SHAPE');
         const id=byPath.get(pathKey(row[pathColumn]));
         need(id && !mapped.has(id),'ROW_IDENTITY');
         const values={};
         for (const name of names) values[name]=row[columns[name]];
         need(Object.values(values).every(Number.isFinite) &&
            Number.isInteger(values.stars) && values.stars>0 && values.fwhmPx>0 &&
            values.noise>=0 && values.measurementSigma>=0,'MEASUREMENT_VALUES');
         mapped.set(id,{id,values});
      }
      return {inputOrder:order.map(input=>input.id),records:required.map(id=>mapped.get(id))};
   }
   const forward=measure(plan.inputs);
   const reverse=measure(plan.inputs.slice().reverse());
   const deltas=forward.records.map((row,i)=>{
      const byMetric={};
      for (const name of names) byMetric[name]=reverse.records[i].values[name]-row.values[name];
      return {id:row.id,byMetric};
   });
   need(deltas.every(row=>Object.values(row.byMetric).every(Number.isFinite)),'DELTA_VALUES');
   return {protocol:'BKL046_IMAGEANALYSIS_CONTROL_RESULT_V1',operationRef:plan.operationRef,
      version:plan.version,cache:false,extendedMeasurements:false,forward,reverse,deltas,
      scientificAcceptance:false};
}
