{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.example/contracts/scientific-data-quality-f5-validation.schema.json",
  "title": "BKL-041 F5 real-evidence validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "validationType", "validationId", "validationState", "generatedAt", "sourceCatalog", "sourceProjection", "cohort", "acceptancePolicy", "results", "summary", "decision", "biasDisclosure", "limitations", "authority", "validationDigest"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "validationType": { "const": "SCIENTIFIC_DATA_QUALITY_REAL_EVIDENCE_VALIDATION" },
    "validationId": { "const": "BKL041-F5-REAL-EVIDENCE-V1" },
    "validationState": { "const": "COMPLETE" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceCatalog": { "$ref": "#/$defs/sourceCatalog" },
    "sourceProjection": { "$ref": "#/$defs/sourceProjection" },
    "cohort": { "$ref": "#/$defs/cohort" },
    "acceptancePolicy": { "$ref": "#/$defs/policy" },
    "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/result" } },
    "summary": { "$ref": "#/$defs/summary" },
    "decision": { "$ref": "#/$defs/decision" },
    "biasDisclosure": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "limitations": { "type": "array", "minItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "authority": { "$ref": "#/$defs/authority" },
    "validationDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceCatalog": { "type": "object", "additionalProperties": false, "required": ["path", "digest", "sessionCount", "sessionIds"], "properties": { "path": { "const": "docs/data/scientific-session-catalog.json" }, "digest": { "$ref": "#/$defs/digest" }, "sessionCount": { "type": "integer", "minimum": 0 }, "sessionIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } } },
    "sourceProjection": { "type": "object", "additionalProperties": false, "required": ["path", "digest", "projectionId", "profileId", "profileVersion"], "properties": { "path": { "const": "docs/data/scientific-data-quality-projection.json" }, "digest": { "$ref": "#/$defs/digest" }, "projectionId": { "type": "string" }, "profileId": { "type": "string" }, "profileVersion": { "type": "string" } } },
    "cohort": { "type": "object", "additionalProperties": true, "required": ["cohortId", "selectionRule", "sessionCount", "knownTargets", "targetDistribution", "evidenceAvailability", "assessmentStates"], "properties": { "cohortId": { "const": "ALL-CANONICAL-IMPORTED-SESSIONS-F5" }, "selectionRule": { "const": "ALL_SESSIONS_IN_CANONICAL_CATALOG_NO_OUTCOME_FILTERING" }, "sessionCount": { "type": "integer", "minimum": 0 }, "knownTargets": { "type": "array", "items": { "type": "string" } }, "targetDistribution": { "type": "object" }, "evidenceAvailability": { "type": "object" }, "assessmentStates": { "type": "object" } } },
    "policy": { "type": "object", "additionalProperties": false, "required": ["policyId", "policyVersion", "purpose", "requirements"], "properties": { "policyId": { "const": "DSG-SCIENTIFIC-QUALITY-PRODUCTION-READINESS-1" }, "policyVersion": { "const": "1.0.0" }, "purpose": { "const": "PRODUCTION_CALIBRATION_READINESS_NOT_SCIENTIFIC_QUALITY_THRESHOLD" }, "requirements": { "type": "object" } } },
    "result": { "type": "object", "additionalProperties": false, "required": ["criterionId", "status", "observed", "required", "reason"], "properties": { "criterionId": { "type": "string", "minLength": 1 }, "status": { "enum": ["PASS", "FAIL"] }, "observed": {}, "required": {}, "reason": { "type": "string", "minLength": 1 } } },
    "summary": { "type": "object", "additionalProperties": false, "required": ["passedCriteria", "failedCriteria", "totalCriteria"], "properties": { "passedCriteria": { "type": "integer", "minimum": 0 }, "failedCriteria": { "type": "integer", "minimum": 0 }, "totalCriteria": { "type": "integer", "minimum": 1 } } },
    "decision": { "type": "object", "additionalProperties": false, "required": ["capabilityAcceptance", "productionReadiness", "productionProfileAuthorized", "productionUseAuthorized", "reasonCodes"], "properties": { "capabilityAcceptance": { "const": "ACCEPTED_AS_READ_ONLY_EXPERIMENTAL_WITH_RETAINED_LIMITATIONS" }, "productionReadiness": { "const": "NOT_READY_FOR_PRODUCTION" }, "productionProfileAuthorized": { "const": false }, "productionUseAuthorized": { "const": false }, "reasonCodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } } } },
    "authority": { "type": "object", "additionalProperties": false, "required": ["consumerMode", "productionUseAuthorized", "acceptanceAuthority", "actionAuthority", "safetyAuthority"], "properties": { "consumerMode": { "const": "READ_ONLY" }, "productionUseAuthorized": { "const": false }, "acceptanceAuthority": { "const": false }, "actionAuthority": { "const": "NONE" }, "safetyAuthority": { "const": "LOCAL_PHYSICAL_INTERLOCKS" } } }
  }
}
