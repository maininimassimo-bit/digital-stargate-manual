{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maininimassimo-bit.github.io/digital-stargate-manual/contracts/ai-post-processing-assistant-f5-evaluation.schema.json",
  "title": "BKL-046 F5-A deterministic real-evidence evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "evaluationType", "evaluationState", "identityMethod",
    "evaluationId", "generatedAt", "producer", "producerVersion", "methodId",
    "sourceSnapshots", "methodRegistry", "cohorts", "technicalGates",
    "outcomes", "summary", "authority", "limitations", "evaluationDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "evaluationType": { "const": "BKL046_F5_REAL_EVIDENCE_EVALUATION" },
    "evaluationState": { "const": "F5A_FOUNDATION_EVALUATED" },
    "identityMethod": { "const": "BKL046-F5-CANONICAL-JSON-SHA256-1" },
    "evaluationId": { "type": "string", "pattern": "^BKL046-F5A-[A-F0-9]{24}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "DSG.AiPostProcessingRealEvidenceEvaluator" },
    "producerVersion": { "const": "1.0.0-f5a" },
    "methodId": { "const": "BKL046-F5A-CLOSED-EVALUATION-1" },
    "sourceSnapshots": { "$ref": "#/$defs/sourceSnapshots" },
    "methodRegistry": { "$ref": "#/$defs/methodRegistry" },
    "cohorts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/cohort" }
    },
    "technicalGates": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/technicalGate" }
    },
    "outcomes": { "$ref": "#/$defs/outcomes" },
    "summary": { "$ref": "#/$defs/summary" },
    "authority": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/authority" },
    "limitations": { "$ref": "#/$defs/nonEmptyStringArray" },
    "evaluationDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "stringArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "reasonCode": {
      "enum": [
        "FULL_CANONICAL_POPULATION",
        "NO_EXACT_PROVENANCE_MATCHES",
        "EXACT_PROVENANCE_AVAILABLE",
        "NO_HUMAN_DECISION_RECEIPTS",
        "HUMAN_DECISION_RECEIPTS_AVAILABLE",
        "NO_EXECUTION_EVIDENCE",
        "EXECUTION_EVIDENCE_AVAILABLE",
        "NO_APPROVED_GROUND_TRUTH_METHOD",
        "F5A_FOUNDATION_IMPLEMENTED",
        "F5B_DYNAMIC_UPDATE_NOT_EXECUTED",
        "F5B_CONSUMER_NOT_EXECUTED",
        "PRODUCTION_AUTHORITY_NOT_GRANTED",
        "SCIENTIFIC_EFFECTIVENESS_NOT_ESTABLISHED"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reasonCode" }
    },
    "sourceSnapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "f4Projection", "humanDecisionSourceSet", "executionEvidenceSourceSet"],
      "properties": {
        "catalog": { "$ref": "#/$defs/catalogSnapshot" },
        "f4Projection": { "$ref": "#/$defs/f4ProjectionSnapshot" },
        "humanDecisionSourceSet": { "$ref": "#/$defs/humanDecisionSourceSet" },
        "executionEvidenceSourceSet": { "$ref": "#/$defs/executionEvidenceSourceSet" }
      }
    },
    "catalogSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "sessionCount", "sessionIds"],
      "properties": {
        "path": { "const": "docs/data/scientific-session-catalog.json" },
        "digest": { "$ref": "#/$defs/digest" },
        "sessionCount": { "type": "integer", "minimum": 0 },
        "sessionIds": { "$ref": "#/$defs/stringArray" }
      }
    },
    "f4ProjectionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "projectionId", "generatedAt", "sourceSetDigest", "recordCount"],
      "properties": {
        "path": { "const": "docs/data/ai-post-processing-advisory-projection.json" },
        "digest": { "$ref": "#/$defs/digest" },
        "projectionId": { "type": "string", "pattern": "^BKL046-F4-[A-F0-9]{24}$" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "sourceSetDigest": { "$ref": "#/$defs/digest" },
        "recordCount": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceSetBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "pathPattern", "validationMode", "digest", "entries"],
      "properties": {
        "directory": { "$ref": "#/$defs/nonEmpty" },
        "pathPattern": { "$ref": "#/$defs/nonEmpty" },
        "validationMode": { "const": "RAW_BUILD_TIME_SANITIZED_PUBLIC_SNAPSHOT" },
        "digest": { "$ref": "#/$defs/digest" },
        "entries": { "type": "array" }
      }
    },
    "humanDecisionSourceSet": {
      "allOf": [
        { "$ref": "#/$defs/sourceSetBase" },
        {
          "type": "object",
          "properties": {
            "directory": { "const": "docs/data/ai-post-processing-human-decisions" },
            "entries": { "type": "array", "items": { "$ref": "#/$defs/humanDecisionEntry" } }
          }
        }
      ]
    },
    "executionEvidenceSourceSet": {
      "allOf": [
        { "$ref": "#/$defs/sourceSetBase" },
        {
          "type": "object",
          "properties": {
            "directory": { "const": "docs/data/ai-post-processing-execution-evidence" },
            "entries": { "type": "array", "items": { "$ref": "#/$defs/executionEvidenceEntry" } }
          }
        }
      ]
    },
    "humanDecisionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "digest", "receiptId", "recommendationId", "sessionId",
        "presentedAt", "decidedAt", "disposition", "correlationId",
        "executionState", "actionAuthority"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/data/ai-post-processing-human-decisions/BKL-046-F2-HDR-[0-9]{8}T[0-9]{6}Z-[A-Z0-9][A-Z0-9_-]{0,31}\\.json$"
        },
        "digest": { "$ref": "#/$defs/digest" },
        "receiptId": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/stableId" },
        "recommendationId": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/stableId" },
        "sessionId": { "$ref": "#/$defs/nonEmpty" },
        "presentedAt": { "type": "string", "format": "date-time" },
        "decidedAt": { "type": "string", "format": "date-time" },
        "disposition": {
          "enum": [
            "ACCEPTED_FOR_MANUAL_APPLICATION",
            "EDITED_FOR_MANUAL_APPLICATION",
            "REJECTED",
            "DEFERRED"
          ]
        },
        "correlationId": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/stableId" },
        "executionState": { "const": "NOT_OBSERVED" },
        "actionAuthority": { "const": "NONE" }
      }
    },
    "executionEvidenceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "digest", "evidenceId", "sessionId", "recommendationId",
        "decisionReceiptId", "processingEvidenceRef", "observedAt",
        "executionState", "actionAuthority"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^docs/data/ai-post-processing-execution-evidence/BKL-046-F5-EXE-[0-9]{8}T[0-9]{6}Z-[A-Z0-9][A-Z0-9_-]{0,31}\\.json$"
        },
        "digest": { "$ref": "#/$defs/digest" },
        "evidenceId": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/stableId" },
        "sessionId": { "$ref": "#/$defs/nonEmpty" },
        "recommendationId": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/stableId" },
        "decisionReceiptId": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/stableId" },
        "processingEvidenceRef": {
          "type": "string",
          "pattern": "^docs/architecture/scientific-assets/evidence/BKL-045-F3B-PXP-[0-9]{8}T[0-9]{9}Z-[A-Z0-9][A-Z0-9_-]{0,31}\\.json$"
        },
        "observedAt": { "type": "string", "format": "date-time" },
        "executionState": { "const": "OBSERVED_MANUAL_EXECUTION" },
        "actionAuthority": { "const": "NONE" }
      }
    },
    "methodRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryId", "cohortIds", "selectionRuleIds", "technicalGateIds",
        "technicalStates", "scientificStates", "humanDecisionStates",
        "productionStates", "capabilityOutcomes", "closureRecommendations",
        "gateStates", "evidenceStates", "reasonCodes"
      ],
      "properties": {
        "registryId": { "const": "BKL046-F5A-CLOSED-REGISTRY-1" },
        "cohortIds": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": { "$ref": "#/$defs/cohortId" }
        },
        "selectionRuleIds": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": { "$ref": "#/$defs/selectionRuleId" }
        },
        "technicalGateIds": {
          "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true,
          "items": { "$ref": "#/$defs/technicalGateId" }
        },
        "technicalStates": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": { "$ref": "#/$defs/technicalState" }
        },
        "scientificStates": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": { "$ref": "#/$defs/scientificState" }
        },
        "humanDecisionStates": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": { "$ref": "#/$defs/humanDecisionState" }
        },
        "productionStates": {
          "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": { "$ref": "#/$defs/productionState" }
        },
        "capabilityOutcomes": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": { "$ref": "#/$defs/capabilityOutcome" }
        },
        "closureRecommendations": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": { "$ref": "#/$defs/closureRecommendation" }
        },
        "gateStates": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": { "$ref": "#/$defs/gateState" }
        },
        "evidenceStates": {
          "type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceState" }
        },
        "reasonCodes": {
          "type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true,
          "items": { "$ref": "#/$defs/reasonCode" }
        }
      }
    },
    "cohortId": {
      "enum": [
        "ALL-CANONICAL-SESSIONS-F5",
        "EXACT-PROVENANCE-MATCHED-F5",
        "HUMAN-DECISION-RECEIPTS-F5",
        "EXECUTION-EVIDENCE-F5"
      ]
    },
    "selectionRuleId": {
      "enum": [
        "ALL-CANONICAL-SESSIONS-EXACT-SET-1",
        "F4-PROVENANCE-MATCHED-EXACT-1",
        "F2-HUMAN-DECISION-EXACT-CORRELATION-1",
        "F5-EXECUTION-EVIDENCE-EXACT-CORRELATION-1"
      ]
    },
    "technicalGateId": {
      "enum": [
        "CATALOG_SNAPSHOT_INTEGRITY",
        "F4_PROJECTION_INTEGRITY",
        "FULL_POPULATION_COVERAGE",
        "HUMAN_DECISION_SOURCE_CONTRACT",
        "EXECUTION_EVIDENCE_SOURCE_CONTRACT",
        "CLOSED_METHOD_REGISTRY",
        "F5A_REPORT_DETERMINISM",
        "F5B_DYNAMIC_UPDATE",
        "F5B_CONSUMER"
      ]
    },
    "technicalState": {
      "enum": [
        "READY_FOR_F5_EVALUATION",
        "NOT_ACCEPTED",
        "REJECTED",
        "ACCEPTED_READ_ONLY_WITH_LIMITATIONS"
      ]
    },
    "scientificState": {
      "enum": [
        "NOT_EVALUABLE_CURRENT_EVIDENCE",
        "EVALUATION_REQUIRED",
        "INVALID"
      ]
    },
    "humanDecisionState": { "enum": ["NOT_AVAILABLE", "AVAILABLE"] },
    "productionState": { "enum": ["NOT_READY_FOR_PRODUCTION", "REJECTED_FOR_PRODUCTION"] },
    "capabilityOutcome": {
      "enum": [
        "F5A_EVALUATION_FOUNDATION_READY",
        "NOT_ACCEPTED",
        "REJECTED",
        "ACCEPTED_READ_ONLY_WITH_LIMITATIONS"
      ]
    },
    "closureRecommendation": { "enum": ["KEEP_OPEN", "DO_NOT_CLOSE", "CLOSE_DETERMINISTIC_CAPABILITY"] },
    "gateState": { "enum": ["PASS", "FAIL_CLOSED", "NOT_EXECUTED"] },
    "evidenceState": { "enum": ["AVAILABLE", "NOT_AVAILABLE", "NOT_EVALUABLE"] },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cohortId", "selectionRuleId", "populationCount", "eligibleCount",
        "memberRefs", "evidenceState", "reasonCodes", "limitations"
      ],
      "properties": {
        "cohortId": { "$ref": "#/$defs/cohortId" },
        "selectionRuleId": { "$ref": "#/$defs/selectionRuleId" },
        "populationCount": { "type": "integer", "minimum": 0 },
        "eligibleCount": { "type": "integer", "minimum": 0 },
        "memberRefs": { "$ref": "#/$defs/stringArray" },
        "evidenceState": { "$ref": "#/$defs/evidenceState" },
        "reasonCodes": { "$ref": "#/$defs/reasonCodes" },
        "limitations": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "technicalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gateId", "state", "reasonCodes"],
      "properties": {
        "gateId": { "$ref": "#/$defs/technicalGateId" },
        "state": { "$ref": "#/$defs/gateState" },
        "reasonCodes": { "$ref": "#/$defs/reasonCodes" }
      }
    },
    "technicalOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCodes"],
      "properties": {
        "state": {
          "enum": [
            "READY_FOR_F5_EVALUATION",
            "NOT_ACCEPTED",
            "REJECTED",
            "ACCEPTED_READ_ONLY_WITH_LIMITATIONS"
          ]
        },
        "reasonCodes": { "$ref": "#/$defs/reasonCodes" }
      }
    },
    "scientificOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCodes"],
      "properties": {
        "state": {
          "enum": [
            "NOT_EVALUABLE_CURRENT_EVIDENCE",
            "EVALUATION_REQUIRED",
            "INVALID"
          ]
        },
        "reasonCodes": { "$ref": "#/$defs/reasonCodes" }
      }
    },
    "humanDecisionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCodes"],
      "properties": {
        "state": { "$ref": "#/$defs/humanDecisionState" },
        "reasonCodes": { "$ref": "#/$defs/reasonCodes" }
      }
    },
    "productionOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCodes"],
      "properties": {
        "state": { "$ref": "#/$defs/productionState" },
        "reasonCodes": { "$ref": "#/$defs/reasonCodes" }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "technical", "scientific", "humanDecision", "production",
        "capabilityOutcome", "closureRecommendation", "aiModelImplemented"
      ],
      "properties": {
        "technical": { "$ref": "#/$defs/technicalOutcome" },
        "scientific": { "$ref": "#/$defs/scientificOutcome" },
        "humanDecision": { "$ref": "#/$defs/humanDecisionOutcome" },
        "production": { "$ref": "#/$defs/productionOutcome" },
        "capabilityOutcome": { "$ref": "#/$defs/capabilityOutcome" },
        "closureRecommendation": { "$ref": "#/$defs/closureRecommendation" },
        "aiModelImplemented": { "const": false }
      }
    },
    "targetCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "count"],
      "properties": {
        "target": { "$ref": "#/$defs/nonEmpty" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonicalSessions", "provenanceEligible", "humanDecisionReceipts",
        "executionEvidence", "uncorrelatedProcessingSources", "targetDistribution"
      ],
      "properties": {
        "canonicalSessions": { "type": "integer", "minimum": 0 },
        "provenanceEligible": { "type": "integer", "minimum": 0 },
        "humanDecisionReceipts": { "type": "integer", "minimum": 0 },
        "executionEvidence": { "type": "integer", "minimum": 0 },
        "uncorrelatedProcessingSources": { "type": "integer", "minimum": 0 },
        "targetDistribution": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/targetCount" }
        }
      }
    },
    "rawHumanDecisionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "sourceType", "authority", "sessionId",
        "recommendationId", "receipt", "artifactDigest"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "sourceType": { "const": "BKL046_HUMAN_DECISION_RECEIPT" },
        "authority": { "const": "human_decision" },
        "sessionId": { "$ref": "#/$defs/nonEmpty" },
        "recommendationId": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/stableId" },
        "receipt": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/humanDecisionReceipt" },
        "artifactDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "rawExecutionEvidenceSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "sourceType", "authority", "evidenceId", "sessionId",
        "recommendationId", "decisionReceiptId", "processingEvidenceRef",
        "observedAt", "executionState", "actionAuthority", "artifactDigest"
      ],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "sourceType": { "const": "BKL046_RECOMMENDATION_EXECUTION_EVIDENCE" },
        "authority": { "const": "processing_execution_evidence" },
        "evidenceId": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/stableId" },
        "sessionId": { "$ref": "#/$defs/nonEmpty" },
        "recommendationId": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/stableId" },
        "decisionReceiptId": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/stableId" },
        "processingEvidenceRef": {
          "type": "string",
          "pattern": "^docs/architecture/scientific-assets/evidence/BKL-045-F3B-PXP-[0-9]{8}T[0-9]{9}Z-[A-Z0-9][A-Z0-9_-]{0,31}\\.json$"
        },
        "observedAt": { "type": "string", "format": "date-time" },
        "executionState": { "const": "OBSERVED_MANUAL_EXECUTION" },
        "actionAuthority": { "const": "NONE" },
        "artifactDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}

