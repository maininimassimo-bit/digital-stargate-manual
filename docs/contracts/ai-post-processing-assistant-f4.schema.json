{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maininimassimo-bit.github.io/digital-stargate-manual/contracts/ai-post-processing-assistant-f4.schema.json",
  "title": "BKL-046 F4 session/provenance-driven read-only advisory projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "projectionType", "projectionState", "identityMethod", "projectionId",
    "generatedAt", "producer", "producerVersion", "methodId", "sourceCatalog", "sourceSet",
    "records", "summary", "authority", "limitations", "projectionDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1" },
    "projectionType": { "const": "AI_POST_PROCESSING_ADVISORY_PROJECTION" },
    "projectionState": { "const": "PRE_DECISION_READ_ONLY" },
    "identityMethod": { "const": "BKL046-F4-CANONICAL-JSON-SHA256-1" },
    "projectionId": { "type": "string", "pattern": "^BKL046-F4-[A-F0-9]{24}$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "DSG.AiPostProcessingAdvisoryProjection" },
    "producerVersion": { "const": "1.0.0-f4b" },
    "methodId": { "const": "BKL046-F3-CLOSED-RULES-1" },
    "sourceCatalog": { "$ref": "#/$defs/sourceCatalog" },
    "sourceSet": { "$ref": "#/$defs/sourceSet" },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } },
    "summary": { "$ref": "#/$defs/summary" },
    "authority": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/authority" },
    "limitations": { "$ref": "#/$defs/limitations" },
    "projectionDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "nonEmpty": { "type": "string", "minLength": 1 },
    "nullableNonEmpty": { "type": ["string", "null"], "minLength": 1 },
    "limitations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
    "repositoryPath": {
      "type": "string",
      "pattern": "^docs/architecture/scientific-assets/evidence/BKL-045-F3B-PXP-[0-9]{8}T[0-9]{9}Z-[A-Z0-9][A-Z0-9_-]{0,31}\\.json$"
    },
    "sourceCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "sessionCount", "sessionIds"],
      "properties": {
        "path": { "const": "docs/data/scientific-session-catalog.json" },
        "digest": { "$ref": "#/$defs/digest" },
        "sessionCount": { "type": "integer", "minimum": 0 },
        "sessionIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "sourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validationMode", "digest", "entries"],
      "properties": {
        "validationMode": { "const": "RAW_BUILD_TIME_SANITIZED_PUBLIC_SNAPSHOT" },
        "digest": { "$ref": "#/$defs/digest" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/sourceEntry" } }
      }
    },
    "sourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "sidecarId", "exportedAt", "sessionId", "target", "workflowId", "completeness", "limitations"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "digest": { "$ref": "#/$defs/digest" },
        "sidecarId": { "type": "string", "pattern": "^PXP-" },
        "exportedAt": { "type": "string", "format": "date-time" },
        "sessionId": { "$ref": "#/$defs/nonEmpty" },
        "target": { "$ref": "#/$defs/nullableNonEmpty" },
        "workflowId": { "$ref": "#/$defs/nonEmpty" },
        "completeness": { "enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"] },
        "limitations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "ruleEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleId", "recommendationId", "decision", "reasonCodes"],
      "properties": {
        "ruleId": { "enum": ["GOVERNANCE_READINESS", "PROCESSING_HISTORY_AVAILABILITY"] },
        "recommendationId": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/stableId" },
        "decision": { "enum": ["PASS", "FAIL_CLOSED"] },
        "reasonCodes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recordId", "sessionId", "target", "correlationState", "sourceRefs", "inputArtifactDigest", "subject", "sourceBindings", "recommendations", "ruleEvaluations", "decisionState", "recordDigest"],
      "properties": {
        "recordId": { "type": "string", "pattern": "^F4-[A-F0-9]{24}$" },
        "sessionId": { "$ref": "#/$defs/nonEmpty" },
        "target": { "$ref": "#/$defs/nullableNonEmpty" },
        "correlationState": { "enum": ["PROVENANCE_MATCHED", "PROVENANCE_UNAVAILABLE", "CORRELATION_AMBIGUOUS", "CORRELATION_INVALID"] },
        "sourceRefs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/repositoryPath" } },
        "inputArtifactDigest": { "$ref": "#/$defs/digest" },
        "subject": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/subject" },
        "sourceBindings": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/sourceBinding" } },
        "recommendations": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "ai-post-processing-assistant-f2.schema.json#/$defs/recommendation" } },
        "ruleEvaluations": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/ruleEvaluation" } },
        "decisionState": { "const": "NOT_PRESENT_PRE_DECISION" },
        "recordDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalSessions", "provenanceMatched", "provenanceUnavailable", "correlationAmbiguous", "correlationInvalid", "governancePass", "governanceFailClosed", "processingHistoryPass", "processingHistoryFailClosed", "uncorrelatedSources"],
      "properties": {
        "totalSessions": { "type": "integer", "minimum": 0 },
        "provenanceMatched": { "type": "integer", "minimum": 0 },
        "provenanceUnavailable": { "type": "integer", "minimum": 0 },
        "correlationAmbiguous": { "type": "integer", "minimum": 0 },
        "correlationInvalid": { "type": "integer", "minimum": 0 },
        "governancePass": { "type": "integer", "minimum": 0 },
        "governanceFailClosed": { "type": "integer", "minimum": 0 },
        "processingHistoryPass": { "type": "integer", "minimum": 0 },
        "processingHistoryFailClosed": { "type": "integer", "minimum": 0 },
        "uncorrelatedSources": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
