{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maininimassimo-bit.github.io/digital-stargate-manual/contracts/scientific-data-quality-f3.schema.json",
  "title": "BKL-041 F3 deterministic scoring known-answer fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureType", "fixtureMode", "sessionId", "profile", "dimensions", "authority", "expected", "limitations", "fixtureDigest"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "fixtureType": {"const": "SCIENTIFIC_DATA_QUALITY_F3_KNOWN_ANSWER"},
    "fixtureMode": {"const": "BOUNDED_SYNTHETIC_FIXTURE"},
    "sessionId": {"type": "string", "minLength": 1},
    "profile": {"$ref": "#/$defs/profile"},
    "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
    "authority": {"$ref": "#/$defs/authority"},
    "expected": {"$ref": "#/$defs/expected"},
    "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "fixtureDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "factor": {"type": "number", "minimum": 0, "maximum": 1},
    "scoreScale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "roundingDigits"],
      "properties": {
        "min": {"const": 0},
        "max": {"const": 100},
        "roundingDigits": {"type": "integer", "minimum": 0, "maximum": 6}
      }
    },
    "confidenceMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methodId", "methodVersion", "semantic", "evidenceClassFactors", "qualityFactors", "completenessFactors", "calibrationFactors"],
      "properties": {
        "methodId": {"const": "DSG-EVIDENCE-SUPPORT-PRODUCT"},
        "methodVersion": {"const": "1.0.0"},
        "semantic": {"const": "EVIDENCE_SUPPORT_NOT_PROBABILITY"},
        "evidenceClassFactors": {
          "type": "object", "additionalProperties": false, "required": ["OBSERVED", "DECLARED", "SUGGESTED"],
          "properties": {"OBSERVED": {"$ref": "#/$defs/factor"}, "DECLARED": {"$ref": "#/$defs/factor"}, "SUGGESTED": {"$ref": "#/$defs/factor"}}
        },
        "qualityFactors": {
          "type": "object", "additionalProperties": false, "required": ["VALID", "STALE", "UNKNOWN", "INVALID"],
          "properties": {"VALID": {"$ref": "#/$defs/factor"}, "STALE": {"$ref": "#/$defs/factor"}, "UNKNOWN": {"$ref": "#/$defs/factor"}, "INVALID": {"$ref": "#/$defs/factor"}}
        },
        "completenessFactors": {
          "type": "object", "additionalProperties": false, "required": ["COMPLETE", "PARTIAL", "UNAVAILABLE"],
          "properties": {"COMPLETE": {"$ref": "#/$defs/factor"}, "PARTIAL": {"$ref": "#/$defs/factor"}, "UNAVAILABLE": {"$ref": "#/$defs/factor"}}
        },
        "calibrationFactors": {
          "type": "object", "additionalProperties": false, "required": ["PROVEN", "NOT_PROVEN", "NOT_APPLICABLE", "UNKNOWN"],
          "properties": {"PROVEN": {"$ref": "#/$defs/factor"}, "NOT_PROVEN": {"$ref": "#/$defs/factor"}, "NOT_APPLICABLE": {"$ref": "#/$defs/factor"}, "UNKNOWN": {"$ref": "#/$defs/factor"}}
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "min", "max", "direction", "outOfRangePolicy"],
      "properties": {
        "type": {"const": "LINEAR"},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "direction": {"enum": ["HIGHER_IS_BETTER", "LOWER_IS_BETTER"]},
        "outOfRangePolicy": {"const": "REJECT"}
      }
    },
    "dimensionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "requirement", "weight", "unit", "normalization"],
      "properties": {
        "dimension": {"type": "string", "minLength": 1},
        "requirement": {"enum": ["REQUIRED", "OPTIONAL", "CONTEXT_ONLY"]},
        "weight": {"type": "number", "minimum": 0, "maximum": 1},
        "unit": {"type": "string", "minLength": 1},
        "normalization": {"$ref": "#/$defs/normalization"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "profileVersion", "profileState", "algorithmId", "algorithmVersion", "scoreScale", "confidenceMethod", "dimensions", "limitations", "profileDigest"],
      "properties": {
        "profileId": {"const": "DSG-SCIENTIFIC-QUALITY-SYNTHETIC-DEMONSTRATOR"},
        "profileVersion": {"const": "1.0.0-f3"},
        "profileState": {"const": "SYNTHETIC_DEMONSTRATOR_F3"},
        "algorithmId": {"const": "DSG-WEIGHTED-LINEAR-SCORE"},
        "algorithmVersion": {"const": "1.0.0"},
        "scoreScale": {"$ref": "#/$defs/scoreScale"},
        "confidenceMethod": {"$ref": "#/$defs/confidenceMethod"},
        "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimensionRule"}},
        "limitations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "profileDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "value", "unit", "evidenceClass", "quality", "completeness", "coverage", "calibrationState", "eligibility", "evidenceRefs"],
      "properties": {
        "dimension": {"type": "string", "minLength": 1},
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "evidenceClass": {"enum": ["OBSERVED", "DECLARED", "SUGGESTED"]},
        "quality": {"enum": ["VALID", "STALE", "UNKNOWN", "INVALID"]},
        "completeness": {"enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"]},
        "coverage": {"type": "number", "minimum": 0, "maximum": 1},
        "calibrationState": {"enum": ["PROVEN", "NOT_PROVEN", "NOT_APPLICABLE", "UNKNOWN"]},
        "eligibility": {"enum": ["ELIGIBLE_FOR_FUTURE_NORMALIZATION", "CONDITIONAL", "CONTEXT_ONLY", "UNAVAILABLE", "INVALID"]},
        "evidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumerMode", "acceptanceAuthority", "actionAuthority", "safetyAuthority"],
      "properties": {
        "consumerMode": {"const": "READ_ONLY"},
        "acceptanceAuthority": {"const": false},
        "actionAuthority": {"const": "NONE"},
        "safetyAuthority": {"const": "LOCAL_PHYSICAL_INTERLOCKS"}
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentState", "scoreValue", "confidenceValue", "evidenceCoverage", "assessmentDigest"],
      "properties": {
        "assessmentState": {"const": "AVAILABLE"},
        "scoreValue": {"type": "number", "minimum": 0, "maximum": 100},
        "confidenceValue": {"type": "number", "minimum": 0, "maximum": 100},
        "evidenceCoverage": {"type": "number", "minimum": 0, "maximum": 1},
        "assessmentDigest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
