{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maininimassimo-bit.github.io/digital-stargate-manual/contracts/ai-post-processing-assistant-f2.schema.json",
  "title": "Digital StarGate BKL-046 F2 Advisory Recommendation and Human Decision Contract Fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractType", "identityMethod", "fixtureId", "fixtureMode", "generatedAt", "subject", "sourceBindings", "recommendations", "humanDecisionReceipts", "authority", "limitations", "artifactDigest"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "contractType": {"const": "AI_POST_PROCESSING_ASSISTANT_F2_FIXTURE"},
    "identityMethod": {"const": "BKL046-F2-CANONICAL-JSON-SHA256-1"},
    "fixtureId": {"$ref": "#/$defs/stableId"},
    "fixtureMode": {"const": "BOUNDED_SYNTHETIC_FIXTURE"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "subject": {"$ref": "#/$defs/subject"},
    "sourceBindings": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/sourceBinding"}},
    "recommendations": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/recommendation"}},
    "humanDecisionReceipts": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/humanDecisionReceipt"}},
    "authority": {"$ref": "#/$defs/authority"},
    "limitations": {"allOf": [{"$ref": "#/$defs/stringArray"}, {"minItems": 1}]},
    "artifactDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "stableId": {"type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "stringArray": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectId", "subjectType", "assetRef", "sessionRef", "workflowRef", "stepRef", "correlationState"],
      "properties": {
        "subjectId": {"$ref": "#/$defs/stableId"},
        "subjectType": {"enum": ["SCIENTIFIC_ASSET", "PIXINSIGHT_WORKFLOW", "PIXINSIGHT_PROCESS_STEP"]},
        "assetRef": {"type": ["string", "null"], "maxLength": 2048},
        "sessionRef": {"type": ["string", "null"], "maxLength": 2048},
        "workflowRef": {"type": ["string", "null"], "maxLength": 2048},
        "stepRef": {"type": ["string", "null"], "maxLength": 2048},
        "correlationState": {"enum": ["RESOLVED", "PARTIAL", "UNRESOLVED"]}
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindingId", "semanticType", "evidenceClass", "sourceAuthority", "sourceRef", "lifecycleState", "quality", "completeness", "citationRefs", "limitations", "bindingDigest"],
      "properties": {
        "bindingId": {"$ref": "#/$defs/stableId"},
        "semanticType": {"enum": ["observation", "evidence", "claim", "recommendation"]},
        "evidenceClass": {"enum": ["OBSERVED", "DECLARED", "SUGGESTED"]},
        "sourceAuthority": {"enum": ["repository_authority", "scientific_catalog", "analytics_product", "session_projection", "processing_evidence", "projection", "unknown"]},
        "sourceRef": {"type": "string", "minLength": 1, "maxLength": 2048},
        "lifecycleState": {"enum": ["incomplete", "unknown", "draft", "validated", "superseded", "rejected"]},
        "quality": {"enum": ["VALID", "STALE", "UNKNOWN", "INVALID"]},
        "completeness": {"enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"]},
        "citationRefs": {"allOf": [{"$ref": "#/$defs/stringArray"}, {"minItems": 1}]},
        "limitations": {"$ref": "#/$defs/stringArray"},
        "bindingDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "contractRef", "value", "limitations"],
      "properties": {
        "state": {"const": "UNAVAILABLE_F2"},
        "contractRef": {"type": "null"},
        "value": {"type": "null"},
        "limitations": {"allOf": [{"$ref": "#/$defs/stringArray"}, {"minItems": 1}]}
      }
    },
    "parameterAdvice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterId", "mode", "unit", "categoricalValue", "lowerBound", "upperBound", "applicability", "evidenceRefs", "limitations"],
      "properties": {
        "parameterId": {"type": ["string", "null"], "maxLength": 256},
        "mode": {"enum": ["CATEGORICAL", "BOUNDED_INTERVAL", "UNKNOWN_NOT_RECOMMENDED"]},
        "unit": {"type": ["string", "null"], "maxLength": 64},
        "categoricalValue": {"type": ["string", "null"], "maxLength": 1024},
        "lowerBound": {"type": ["number", "null"]},
        "upperBound": {"type": ["number", "null"]},
        "applicability": {"type": "string", "minLength": 1, "maxLength": 2048},
        "evidenceRefs": {"$ref": "#/$defs/stringArray"},
        "limitations": {"allOf": [{"$ref": "#/$defs/stringArray"}, {"minItems": 1}]}
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendationId", "semanticType", "aiDerived", "producer", "producerVersion", "methodId", "generatedAt", "correlationId", "subjectRef", "category", "lifecycleState", "proposedAction", "rationale", "sourceBindingRefs", "citationRefs", "provenanceRefs", "parameterAdvice", "conflicts", "unknowns", "confidence", "limitations", "recommendationDigest"],
      "properties": {
        "recommendationId": {"$ref": "#/$defs/stableId"},
        "semanticType": {"const": "recommendation"},
        "aiDerived": {"type": "boolean"},
        "producer": {"type": "string", "minLength": 1, "maxLength": 256},
        "producerVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "methodId": {"type": "string", "minLength": 1, "maxLength": 128},
        "generatedAt": {"type": "string", "format": "date-time"},
        "correlationId": {"$ref": "#/$defs/stableId"},
        "subjectRef": {"$ref": "#/$defs/stableId"},
        "category": {"enum": ["PROCESS_ORDER", "PARAMETER_RANGE", "QUALITY_CHECK", "WORKFLOW_ALTERNATIVE", "STOP_AND_REVIEW"]},
        "lifecycleState": {"enum": ["incomplete", "unknown", "draft", "validated", "superseded", "rejected"]},
        "proposedAction": {"type": "string", "minLength": 1, "maxLength": 4096},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4096},
        "sourceBindingRefs": {"allOf": [{"$ref": "#/$defs/stringArray"}, {"minItems": 1}]},
        "citationRefs": {"allOf": [{"$ref": "#/$defs/stringArray"}, {"minItems": 1}]},
        "provenanceRefs": {"allOf": [{"$ref": "#/$defs/stringArray"}, {"minItems": 1}]},
        "parameterAdvice": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/parameterAdvice"}},
        "conflicts": {"$ref": "#/$defs/stringArray"},
        "unknowns": {"$ref": "#/$defs/stringArray"},
        "confidence": {"$ref": "#/$defs/confidence"},
        "limitations": {"allOf": [{"$ref": "#/$defs/stringArray"}, {"minItems": 1}]},
        "recommendationDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "decisionEdit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameterId", "selectedValue", "unit", "reason"],
      "properties": {
        "parameterId": {"type": "string", "minLength": 1, "maxLength": 256},
        "selectedValue": {"type": ["number", "string", "boolean"]},
        "unit": {"type": ["string", "null"], "maxLength": 64},
        "reason": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "humanDecisionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptId", "recommendationId", "presentedAt", "decidedAt", "actorRef", "disposition", "decisionEdits", "decisionRationale", "correlationId", "executionState", "executionEvidenceRefs", "actionAuthority", "receiptDigest"],
      "properties": {
        "receiptId": {"$ref": "#/$defs/stableId"},
        "recommendationId": {"$ref": "#/$defs/stableId"},
        "presentedAt": {"type": "string", "format": "date-time"},
        "decidedAt": {"type": "string", "format": "date-time"},
        "actorRef": {"$ref": "#/$defs/stableId"},
        "disposition": {"enum": ["ACCEPTED_FOR_MANUAL_APPLICATION", "EDITED_FOR_MANUAL_APPLICATION", "REJECTED", "DEFERRED"]},
        "decisionEdits": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/decisionEdit"}},
        "decisionRationale": {"type": ["string", "null"], "maxLength": 4096},
        "correlationId": {"$ref": "#/$defs/stableId"},
        "executionState": {"const": "NOT_OBSERVED"},
        "executionEvidenceRefs": {"type": "array", "maxItems": 0},
        "actionAuthority": {"const": "NONE"},
        "receiptDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumerMode", "advisoryOnly", "acceptanceAuthority", "actionAuthority", "executionAuthority", "safetyAuthority", "pixInsightApplyAuthorized", "automaticAcceptanceAuthorized"],
      "properties": {
        "consumerMode": {"const": "READ_ONLY"},
        "advisoryOnly": {"const": true},
        "acceptanceAuthority": {"const": "HUMAN_ONLY"},
        "actionAuthority": {"const": "NONE"},
        "executionAuthority": {"const": "NONE"},
        "safetyAuthority": {"const": "LOCAL_PHYSICAL_INTERLOCKS"},
        "pixInsightApplyAuthorized": {"const": false},
        "automaticAcceptanceAuthorized": {"const": false}
      }
    }
  }
}
