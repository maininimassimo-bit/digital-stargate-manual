{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:digital-stargate:schema:observation-session:1.0",
  "title": "Observation Session",
  "type": "object",
  "required": ["sessionId", "observatoryId", "state", "createdAt", "plan"],
  "properties": {
    "sessionId": { "type": "string", "format": "uuid" },
    "observatoryId": { "type": "string", "minLength": 1 },
    "state": {
      "type": "string",
      "enum": ["DRAFT", "VALIDATED", "READY", "STARTING", "RUNNING", "PAUSED", "SHUTTING_DOWN", "COMPLETED", "ABORTED", "FAILED"]
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "startedAt": { "type": ["string", "null"], "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "plan": {
      "type": "object",
      "required": ["planId", "targets"],
      "properties": {
        "planId": { "type": "string", "minLength": 1 },
        "targets": { "type": "array", "minItems": 1, "items": { "type": "object" } }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
