{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.invalid/schemas/bkl033-digital-twin-contract.schema.json",
  "title": "BKL-033 Observatory Digital Twin Contract",
  "type": "object",
  "required": ["schemaVersion", "authority", "commandAuthority", "safetyAuthority", "nodes", "dependencies"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "authority": {"const": "projection"},
    "commandAuthority": {"const": "NONE"},
    "safetyAuthority": {"const": "NONE"},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}, "minItems": 1},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "node": {"type": "object", "required": ["id", "kind", "authority", "state", "freshness", "sourceRefs"], "properties": {"id": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "minLength": 1}, "authority": {"type": "string", "minLength": 1}, "state": {"enum": ["observed", "stale", "unknown", "unavailable"]}, "freshness": {"enum": ["current", "stale", "unknown", "not_applicable"]}, "sourceRefs": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1}}, "additionalProperties": false},
    "dependency": {"type": "object", "required": ["id", "from", "to", "relation", "state", "evidenceRefs"], "properties": {"id": {"$ref": "#/$defs/id"}, "from": {"$ref": "#/$defs/id"}, "to": {"$ref": "#/$defs/id"}, "relation": {"type": "string", "minLength": 1}, "state": {"enum": ["observed", "stale", "unknown", "unavailable"]}, "evidenceRefs": {"type": "array", "items": {"$ref": "#/$defs/id"}, "minItems": 1}}, "additionalProperties": false}
  }
}
