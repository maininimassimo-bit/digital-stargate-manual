{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.invalid/schemas/bkl034-f2-image-archive-ingestion.schema.json",
  "title": "BKL-034-F2 Governed Image Ingestion and Metadata Archive Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authority", "ingestionMode", "writeAuthority", "commandAuthority", "safetyAuthority", "assets"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "authority": {"const": "archive_projection"},
    "ingestionMode": {"const": "governed_read_only_projection"},
    "writeAuthority": {"const": "NONE"},
    "commandAuthority": {"const": "NONE"},
    "safetyAuthority": {"const": "NONE"},
    "assets": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/asset"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$", "maxLength": 160},
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["imageId", "objectRef", "mediaType", "byteSize", "sha256", "archiveState", "sessionRef", "targetRef", "metadataRefs", "workflowRefs", "derivativeRefs", "sourceRefs"],
      "properties": {
        "imageId": {"$ref": "#/$defs/id"},
        "objectRef": {"type": "string", "pattern": "^obj:[A-Za-z0-9._:-]+$"},
        "mediaType": {"enum": ["image/x-xisf", "image/fits", "image/tiff", "image/png", "image/jpeg"]},
        "byteSize": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "archiveState": {"enum": ["CATALOGED", "QUARANTINED", "UNAVAILABLE"]},
        "sessionRef": {"type": "string", "pattern": "^session:[A-Za-z0-9._:-]+$"},
        "targetRef": {"type": "string", "pattern": "^target:[A-Za-z0-9._:-]+$"},
        "metadataRefs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/id"}},
        "workflowRefs": {"type": "array", "items": {"$ref": "#/$defs/id"}},
        "derivativeRefs": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/id"}},
        "sourceRefs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "pattern": "^src:[A-Za-z0-9._:-]+$"}},
        "metadataState": {"enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"]}
      }
    }
  }
}
