{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.invalid/schemas/bkl034-scientific-image-gallery.schema.json",
  "title": "BKL-034 Scientific Image Gallery Contract",
  "type": "object",
  "required": ["schemaVersion", "authority", "commandAuthority", "safetyAuthority", "items"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "authority": {"const": "projection"},
    "commandAuthority": {"const": "NONE"},
    "safetyAuthority": {"const": "NONE"},
    "items": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+$"},
    "ref": {"type": "string", "pattern": "^src:[A-Za-z0-9._:-]+$"},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "assetType", "state", "freshness", "sessionRef", "targetRef", "provenanceRefs", "sourceRefs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "assetType": {"const": "scientific_image"},
        "state": {"enum": ["observed", "stale", "unknown", "unavailable"]},
        "freshness": {"enum": ["current", "stale", "unknown", "not_applicable"]},
        "sessionRef": {"$ref": "#/$defs/id"},
        "targetRef": {"$ref": "#/$defs/id"},
        "provenanceRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "sourceRefs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
        "caption": {"type": "string", "maxLength": 240}
      }
    }
  }
}
