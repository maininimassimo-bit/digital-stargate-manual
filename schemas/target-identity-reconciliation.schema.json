{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.local/schemas/target-identity-reconciliation.schema.json",
  "title": "Digital StarGate Target Identity Reconciliation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","component","authority","baseline_commit","source_contract","bounds","matches","conflicts"],
  "properties": {
    "schema_version": {"const":"1.0"},
    "component": {"const":"DSG.TargetIdentityReconciliation"},
    "authority": {"const":"projection"},
    "baseline_commit": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "source_contract": {
      "type":"object","additionalProperties":false,
      "required":["path","authority","key","accepted_states"],
      "properties": {
        "path":{"const":"data/analytics/metadata/session-scientific-metadata.csv"},
        "authority":{"const":"analytics_projection"},
        "key":{"const":"session_id"},
        "accepted_states":{"type":"array","const":["REGISTERED"]}
      }
    },
    "bounds": {
      "type":"object","additionalProperties":false,
      "required":["max_matches","max_conflicts"],
      "properties": {
        "max_matches":{"type":"integer","minimum":1,"maximum":5},
        "max_conflicts":{"type":"integer","minimum":0,"maximum":5}
      }
    },
    "matches": {"type":"array","maxItems":5,"items":{"$ref":"#/$defs/match"}},
    "conflicts": {"type":"array","maxItems":5,"items":{"$ref":"#/$defs/conflict"}}
  },
  "$defs": {
    "ref":{"type":"string","minLength":2},
    "match": {
      "type":"object","additionalProperties":false,
      "required":["target_key","target_id","canonical_name","aliases","session_ids","identity_state","source_authority","source_refs","method_id"],
      "properties": {
        "target_key":{"type":"string","pattern":"^dsg-target:[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "target_id":{"type":"string","pattern":"^TGT-[A-Z0-9-]+$"},
        "canonical_name":{"type":"string","minLength":1},
        "aliases":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
        "session_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":2}},
        "identity_state":{"const":"validated"},
        "source_authority":{"const":"analytics_projection"},
        "source_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/ref"}},
        "method_id":{"const":"BKL035-F3-EXACT-ID-RECONCILIATION-1"}
      }
    },
    "conflict": {
      "type":"object","additionalProperties":false,
      "required":["conflict_id","target_key","reason","candidate_target_ids","session_ids","identity_state","method_id"],
      "properties": {
        "conflict_id":{"type":"string","pattern":"^CONFLICT-TKB-[A-Z0-9-]+$"},
        "target_key":{"type":"string"},
        "reason":{"enum":["TARGET_ID_DISAGREEMENT","CANONICAL_NAME_DISAGREEMENT","ALIAS_COLLISION"]},
        "candidate_target_ids":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string"}},
        "session_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "identity_state":{"const":"conflicted"},
        "method_id":{"const":"BKL035-F3-EXACT-ID-RECONCILIATION-1"}
      }
    }
  }
}
