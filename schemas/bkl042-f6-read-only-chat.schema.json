{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.example/schemas/bkl042-f6-read-only-chat.schema.json",
  "title": "BKL-042 F6 Read-Only Chat Projection",
  "type": "object",
  "required": ["schemaVersion", "contractType", "mode", "responses", "authority", "limitations"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "contractType": { "const": "BKL042_F6_READ_ONLY_CHAT_PROJECTION" },
    "mode": { "const": "BOUNDED_DETERMINISTIC_READ_ONLY" },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["caseId", "question", "state", "answer", "citations", "limitations"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^CASE-[A-Z0-9-]+$" },
          "question": { "type": "string", "minLength": 1 },
          "state": { "enum": ["ANSWERED", "INSUFFICIENT_EVIDENCE", "CONFLICT_REQUIRES_REVIEW"] },
          "answer": { "type": "string" },
          "citations": { "type": "array", "items": { "type": "string" } },
          "limitations": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "authority": {
      "type": "object",
      "required": ["consumerMode", "advisoryOnly", "actionAuthority", "commandAuthority", "executionAuthority", "safetyAuthority", "automaticAcceptanceAuthorized"],
      "properties": {
        "consumerMode": { "const": "READ_ONLY" },
        "advisoryOnly": { "const": true },
        "actionAuthority": { "const": "NONE" },
        "commandAuthority": { "const": "NONE" },
        "executionAuthority": { "const": "NONE" },
        "safetyAuthority": { "const": "NONE" },
        "automaticAcceptanceAuthorized": { "const": false }
      },
      "additionalProperties": false
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
