{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.local/schemas/target-knowledge-base.schema.json",
  "title": "Digital StarGate Target Knowledge Base Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component", "authority", "baseline_commit", "bounds", "identities", "relations", "citations", "provenance_records"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "component": { "const": "DSG.TargetKnowledgeBaseProjection" },
    "authority": { "const": "projection" },
    "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["max_identities", "max_relations"],
      "properties": {
        "max_identities": { "type": "integer", "minimum": 1, "maximum": 5 },
        "max_relations": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "identities": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/identity" } },
    "relations": { "type": "array", "maxItems": 10, "items": { "$ref": "#/$defs/relation" } },
    "citations": { "type": "array", "items": { "$ref": "#/$defs/citation" } },
    "provenance_records": { "type": "array", "items": { "$ref": "#/$defs/provenance" } }
  },
  "$defs": {
    "ref": { "type": "string", "minLength": 2 },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["target_key", "canonical_name", "aliases", "identity_state", "source_refs", "citation_refs", "provenance_refs"],
      "properties": {
        "target_key": { "type": "string", "pattern": "^dsg-target:[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "canonical_name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "identity_state": { "enum": ["validated", "conflicted", "incomplete", "unknown"] },
        "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "citation_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "provenance_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "relation_type", "target_key", "session_id", "object_ref", "source_refs", "citation_refs", "provenance_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/ref" },
        "relation_type": { "enum": ["TARGET_HAS_SESSION", "TARGET_HAS_SQM_EVIDENCE", "TARGET_USES_SETUP", "TARGET_HAS_ASSET", "TARGET_HAS_PROCESSING_PROVENANCE", "TARGET_ALIAS_OF", "TARGET_IDENTITY_CONFLICT"] },
        "target_key": { "type": "string" },
        "session_id": { "type": ["string", "null"] },
        "object_ref": { "$ref": "#/$defs/ref" },
        "source_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "citation_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "provenance_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "source_authority", "locator"],
      "properties": {
        "id": { "$ref": "#/$defs/ref" },
        "version": { "type": "string", "minLength": 1 },
        "source_authority": { "enum": ["governed_scientific_projection", "repository_architecture_authority", "analytics_projection", "repository_governance_authority"] },
        "locator": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "record_key", "record_value"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "record_key": { "type": "string", "minLength": 1 },
            "record_value": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "method_id", "input_refs", "output_ref", "citation_refs"],
      "properties": {
        "id": { "$ref": "#/$defs/ref" },
        "version": { "type": "string", "minLength": 1 },
        "method_id": { "enum": ["BKL035-F2-TARGET-KEY-1", "BKL035-F2-SOURCE-LINK-1"] },
        "input_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "output_ref": { "$ref": "#/$defs/ref" },
        "citation_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } }
      }
    }
  }
}
