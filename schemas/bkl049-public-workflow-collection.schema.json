{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BKL-049 current public workflow collection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "authority",
    "actionAuthority",
    "publishedAt",
    "validUntil",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0",
        "2.0"
      ]
    },
    "kind": {
      "const": "BKL049_PUBLIC_COLLECTION"
    },
    "authority": {
      "const": "processing_evidence"
    },
    "actionAuthority": {
      "const": "NONE"
    },
    "publishedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "validUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "oneOf": [
          {
            "$ref": "bkl049-public-workflow.schema.json"
          },
          {
            "$ref": "bkl049-public-workflow-external.schema.json"
          }
        ]
      }
    }
  },
  "description": "Runtime checks also enforce canonical bytes, unique exact identifiers and ordered steps. V1 nonempty releases require a current interval of at most 24 hours. V2 nonempty external releases require a nonfuture publication time and null validUntil, meaning until explicit withdrawal. Empty withdrawal remains V1/null times. Validation is not publication authority.",
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "2.0"
          }
        }
      },
      "then": {
        "properties": {
          "publishedAt": {
            "type": "string"
          },
          "validUntil": {
            "type": "null"
          },
          "records": {
            "minItems": 1,
            "items": {
              "$ref": "bkl049-public-workflow-external.schema.json"
            }
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "records": {
              "maxItems": 0
            }
          }
        },
        "then": {
          "properties": {
            "publishedAt": {
              "type": "null"
            },
            "validUntil": {
              "type": "null"
            }
          }
        },
        "else": {
          "properties": {
            "publishedAt": {
              "type": "string"
            },
            "validUntil": {
              "type": "string"
            }
          }
        }
      }
    }
  ]
}
