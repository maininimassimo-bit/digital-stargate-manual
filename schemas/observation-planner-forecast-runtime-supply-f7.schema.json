{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.local/schemas/observation-planner-forecast-runtime-supply-f7.schema.json",
  "title": "BKL-031 F7 Protected Site Forecast Runtime Supply",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","contractType","supplyId","environment","authority","authorizationId","privacyDecisionId","providerId","upstreamAuthorityId","modelId","runInitialisationUtc","retrievedAtUtc","rawSha256","responseByteLength","location","freshness","requestAccounting","series","availabilityState","boundaries"],
  "properties": {
    "schemaVersion": {"const": "1.1"},
    "contractType": {"const": "BKL031_F7_FORECAST_RUNTIME_SUPPLY"},
    "supplyId": {"type": "string"},
    "environment": {"const": "EVALUATION"},
    "authority": {"const": "NONE"},
    "authorizationId": {"const": "BKL031-F7-PROTECTED-SITE-PROVIDER-REQUEST-AUTH-001"},
    "privacyDecisionId": {"const": "BKL031-F7-PROTECTED-SITE-OUTBOUND-PRIVACY-AUTH-001"},
    "providerId": {"const": "OPEN_METEO"},
    "upstreamAuthorityId": {"const": "ITALIAMETEO_ARPAE"},
    "modelId": {"const": "italia_meteo_arpae_icon_2i"},
    "runInitialisationUtc": {"const": "2026-09-17T12:00Z"},
    "retrievedAtUtc": {"type": "string"},
    "rawSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "responseByteLength": {"type": "integer", "minimum": 1, "maximum": 2000000},
    "location": {"type": "object", "additionalProperties": false, "required": ["classification","siteAuthorityRef","publicLabel","protectedSiteUsed","coordinatesPersisted","coordinatesPublished"], "properties": {"classification": {"const": "PROTECTED_EXACT_SITE"}, "siteAuthorityRef": {"const": "DSG-SITE-RECORD-MANCIANO-001"}, "publicLabel": {"const": "Manciano (GR), Italia"}, "protectedSiteUsed": {"const": true}, "coordinatesPersisted": {"const": false}, "coordinatesPublished": {"const": false}}},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["maxRunAgeHours","runAgeHoursAtRetrieval","state"], "properties": {"maxRunAgeHours": {"const": 18}, "runAgeHoursAtRetrieval": {"type": "number", "minimum": 0, "maximum": 18}, "state": {"const": "FRESH"}}},
    "requestAccounting": {"type": "object", "additionalProperties": false, "required": ["maxProviderRequests","requestOrdinal","budgetState"], "properties": {"maxProviderRequests": {"const": 1}, "requestOrdinal": {"const": 1}, "budgetState": {"const": "1/1_EXHAUSTED"}}},
    "series": {"type": "object", "additionalProperties": false, "required": ["rawInstantCount","acceptedInstantCount","excludedInstantCount","futureAcceptedInstantCount","imputedValueCount","units","accepted","excluded"], "properties": {"rawInstantCount": {"const": 72}, "acceptedInstantCount": {"const": 71}, "excludedInstantCount": {"const": 1}, "futureAcceptedInstantCount": {"const": 66}, "imputedValueCount": {"const": 0}, "units": {"type": "object"}, "accepted": {"type": "array", "minItems": 71, "maxItems": 71}, "excluded": {"type": "array", "minItems": 1, "maxItems": 1}}},
    "availabilityState": {"const": "DEGRADED"},
    "boundaries": {"type": "object", "additionalProperties": false, "required": ["recurringTraffic","productionRuntimeActivated","readinessAuthority","schedulingAuthority","automaticTargetSelection","commandAuthority","safetyAuthority"], "properties": {"recurringTraffic": {"const": false}, "productionRuntimeActivated": {"const": false}, "readinessAuthority": {"const": false}, "schedulingAuthority": {"const": false}, "automaticTargetSelection": {"const": false}, "commandAuthority": {"const": "NONE"}, "safetyAuthority": {"const": "LOCAL_PHYSICAL_INTERLOCKS"}}}
  }
}
