{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.local/schemas/observation-planner-ephemeris-lunar-method-profile-f3b.schema.json",
  "title": "Digital StarGate Observation Planner F3-B Ephemeris/Lunar Method Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractType",
    "profileId",
    "profileSourceRef",
    "profileSourceSha256",
    "decisionRef",
    "decisionState",
    "primaryMethod",
    "crossCheck",
    "timeSemantics",
    "outputSemantics",
    "coverage",
    "errorBudget",
    "networkPolicy",
    "authority",
    "profileDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "contractType": {
      "const": "BKL031_F3B_METHOD_PROFILE"
    },
    "profileId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "profileSourceRef": {
      "type": "string",
      "pattern": "^(?![/\\\\]|[A-Za-z]:|.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "profileSourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decisionRef": {
      "const": "ADR-010"
    },
    "decisionState": {
      "const": "ACCEPTED_REPOSITORY_METHOD_AUTHORITY"
    },
    "primaryMethod": {
      "$ref": "#/$defs/method"
    },
    "crossCheck": {
      "$ref": "#/$defs/crossCheck"
    },
    "timeSemantics": {
      "$ref": "#/$defs/timeSemantics"
    },
    "outputSemantics": {
      "$ref": "#/$defs/outputSemantics"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "errorBudget": {
      "$ref": "#/$defs/errorBudget"
    },
    "networkPolicy": {
      "$ref": "#/$defs/networkPolicy"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "profileDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodId",
        "library",
        "libraryVersion",
        "ephemerisEngine",
        "kernelId",
        "kernelSha256"
      ],
      "properties": {
        "methodId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "library": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "libraryVersion": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "ephemerisEngine": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "kernelId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "kernelSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "crossCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodId",
        "library",
        "libraryVersion",
        "classification",
        "dataIndependenceClaim"
      ],
      "properties": {
        "methodId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "library": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "libraryVersion": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "classification": {
          "const": "IMPLEMENTATION_CROSS_CHECK_SHARED_GOVERNED_SPK"
        },
        "dataIndependenceClaim": {
          "const": false
        }
      }
    },
    "timeSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputTimeScale",
        "calculationTimeScales",
        "earthOrientationSourceId",
        "earthOrientationSha256"
      ],
      "properties": {
        "inputTimeScale": {
          "const": "UTC"
        },
        "calculationTimeScales": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "UTC",
              "TAI",
              "TT",
              "TDB",
              "UT1"
            ]
          }
        },
        "earthOrientationSourceId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "earthOrientationSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "outputSemantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame",
        "refractionModel",
        "azimuthConvention",
        "moonPhaseAngleConvention",
        "allowedFacts"
      ],
      "properties": {
        "frame": {
          "const": "TOPOCENTRIC_ALTAZ"
        },
        "refractionModel": {
          "const": "AIRLESS"
        },
        "azimuthConvention": {
          "const": "EAST_OF_NORTH"
        },
        "moonPhaseAngleConvention": {
          "const": "0_NEW_180_FULL_DEGREES"
        },
        "allowedFacts": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "targetAltitudeDeg",
              "targetAzimuthDeg",
              "meridianTransitUtc",
              "solarAltitudeDeg",
              "moonAltitudeDeg",
              "moonAzimuthDeg",
              "moonPhaseAngleDeg",
              "moonIlluminatedFraction",
              "targetMoonSeparationDeg"
            ]
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startUtc",
        "endUtc",
        "extrapolationAllowed"
      ],
      "properties": {
        "startUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "endUtc": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "extrapolationAllowed": {
          "const": false
        }
      }
    },
    "errorBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "reference",
        "altitudeArcsecMax",
        "azimuthArcsecMax",
        "separationArcsecMax",
        "illuminationAbsoluteMax",
        "transitSecondsMax"
      ],
      "properties": {
        "profileId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "reference": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "altitudeArcsecMax": {
          "const": 3
        },
        "azimuthArcsecMax": {
          "const": 3
        },
        "separationArcsecMax": {
          "const": 3
        },
        "illuminationAbsoluteMax": {
          "const": 0.0001
        },
        "transitSecondsMax": {
          "const": 5
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalReference",
        "contractValidationNetwork"
      ],
      "properties": {
        "externalReference": {
          "const": "DENY"
        },
        "contractValidationNetwork": {
          "const": "DENY"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "authority",
        "repositoryMethodAuthority",
        "runtimeAuthority",
        "executionAuthority",
        "safetyAuthority"
      ],
      "properties": {
        "environment": {
          "const": "TEST"
        },
        "authority": {
          "const": "NONE"
        },
        "repositoryMethodAuthority": {
          "const": "ADR-010"
        },
        "runtimeAuthority": {
          "const": "NONE"
        },
        "executionAuthority": {
          "const": "NONE"
        },
        "safetyAuthority": {
          "const": "LOCAL_PHYSICAL_INTERLOCKS"
        }
      }
    }
  }
}
