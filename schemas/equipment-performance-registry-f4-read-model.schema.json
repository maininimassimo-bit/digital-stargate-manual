{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digital-stargate.local/schemas/equipment-performance-registry-f4-read-model.schema.json",
  "title": "Digital StarGate Equipment Performance Registry F4 Read Model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component", "authority", "action_authority", "source_contract", "view"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "component": { "const": "DSG.EquipmentPerformanceRegistry.F4.ReadModel" },
    "authority": { "const": "projection" },
    "action_authority": { "const": "NONE" },
    "source_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["f3_projection", "f4_contract", "accepted_f3_merge"],
      "properties": {
        "f3_projection": { "const": "docs/data/equipment-performance-registry-f3.json" },
        "f4_contract": { "const": "docs/architecture/telemetry/BKL-039-F4-Equipment-Performance-Read-Only-Consumer-Contract.md" },
        "accepted_f3_merge": { "const": "ce2482aa6b2da62296ebdc221f73f39c1acd3aa2" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration_id", "session_id", "target_name", "filter_name", "frame_type", "metric_name", "unit", "unit_semantics", "angular_calibration_state", "measurement_count", "coverage", "measurements", "statistics", "limitations"],
      "properties": {
        "configuration_id": { "const": "QUATTRO200_TOUPTEK294_BIN1" },
        "session_id": { "const": "2026-07-14_2026-07-15" },
        "target_name": { "const": "LDN 1320" },
        "filter_name": { "const": "LPRO" },
        "frame_type": { "const": "LIGHT" },
        "metric_name": { "const": "FWHM" },
        "unit": { "const": "NINA_FILENAME_FWHM_SOURCE_UNIT" },
        "unit_semantics": { "const": "SOURCE_NATIVE_UNCALIBRATED" },
        "angular_calibration_state": { "const": "NOT_PROVEN" },
        "measurement_count": { "const": 19 },
        "coverage": { "const": "COMPLETE_FOR_DECLARED_POPULATION" },
        "measurements": {
          "type": "array",
          "minItems": 19,
          "maxItems": 19,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record_id", "sequence_number", "timestamp", "value", "method_id", "quality", "source_record_refs", "citation_refs", "provenance_refs"],
            "properties": {
              "record_id": { "type": "string", "minLength": 1 },
              "sequence_number": { "type": "string", "pattern": "^[0-9]{4}$" },
              "timestamp": { "type": "string", "minLength": 1 },
              "value": { "type": "number", "exclusiveMinimum": 0 },
              "method_id": { "const": "BKL039-F3-FWHM-NINA-FILENAME-EXTRACT-V1" },
              "quality": { "const": "SOURCE_RESOLVED" },
              "source_record_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "citation_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "provenance_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "statistics": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["record_id", "statistic_type", "value", "method_id", "sample_count", "coverage", "quality", "source_record_refs", "citation_refs", "provenance_refs"],
            "properties": {
              "record_id": { "type": "string", "minLength": 1 },
              "statistic_type": { "enum": ["MEAN", "MINIMUM", "MAXIMUM", "SAMPLE_STDDEV"] },
              "value": { "type": "number", "exclusiveMinimum": 0 },
              "method_id": { "enum": ["BKL039-F3-FWHM-MEAN-V1", "BKL039-F3-FWHM-MIN-V1", "BKL039-F3-FWHM-MAX-V1", "BKL039-F3-FWHM-SAMPLE-STDDEV-V1"] },
              "sample_count": { "const": 19 },
              "coverage": { "const": "COMPLETE_FOR_DECLARED_POPULATION" },
              "quality": { "const": "COMPLETE_FOR_DECLARED_POPULATION" },
              "source_record_refs": { "type": "array", "minItems": 19, "maxItems": 19, "items": { "type": "string", "minLength": 1 } },
              "citation_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
              "provenance_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 3,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
